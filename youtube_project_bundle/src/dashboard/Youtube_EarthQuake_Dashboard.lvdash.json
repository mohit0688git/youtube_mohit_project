{
  "datasets": [
    {
      "name": "b22eb9de",
      "displayName": "EarthQuake_Detail",
      "queryLines": [
        "select * from silver.earthquake_data"
      ],
      "catalog": "youtube_prod",
      "schema": "default"
    },
    {
      "name": "0fded2c5",
      "displayName": "Earthquake_Type",
      "queryLines": [
        "select count(*) as total_magnitude_bucket,\r\n",
        "magnitude_bucket from (select case\r\n",
        "when mag < 2 then 'Micro (<2)'\r\n",
        "when mag between 2 and 3 then 'Minor(2-3)'\r\n",
        "when mag between 3 and 4 then 'light(3-4)'\r\n",
        "else 'moderate_ (4+)'\r\n",
        "end as magnitude_bucket\r\n",
        "from silver.earthquake_data)\r\n",
        "group by magnitude_bucket"
      ],
      "catalog": "youtube_prod",
      "schema": "default"
    },
    {
      "name": "0e2723b8",
      "displayName": "Global Earthquake Event Counts by Country",
      "queryLines": [
        "SELECT   \r\n",
        "          count(*) AS event_count, \r\n",
        "           CASE   \r\n",
        "         WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]  \r\n",
        "         ELSE split(place, ', ')[1]  \r\n",
        "        END AS country  \r\n",
        "        FROM (  \r\n",
        "           SELECT   \r\n",
        "              time,  \r\n",
        "             title,  \r\n",
        "             mag,  \r\n",
        "             longitude,  \r\n",
        "             place,  \r\n",
        "             latitude  \r\n",
        "           FROM silver.earthquake_data  \r\n",
        "         )  \r\n",
        "         GROUP BY country "
      ],
      "catalog": "youtube_prod",
      "schema": "default"
    }
  ],
